# This file contains example placeholders only. The application reads process
# environment variables; it does not load .env files by itself.
ECOMMERCE_HOST=127.0.0.1
ECOMMERCE_PORT=8080
ECOMMERCE_PROCESS_ROLE=all
ECOMMERCE_DATABASE_URL=sqlite+aiosqlite:///./python-commerce.db
ECOMMERCE_STORAGE_SNAPSHOT=./python-commerce.snapshot.sqlite
ECOMMERCE_SNAPSHOT_INTERVAL_SECONDS=30
ECOMMERCE_INVENTORY_MODE=local
ECOMMERCE_FLASH_SALE_QUEUE=local
ECOMMERCE_DEMO_STOCK=100
ECOMMERCE_DEMO_CAMPAIGN_LIMIT=100

# Optional local dependency settings; replace placeholders before use.
# ECOMMERCE_REDIS_URL=redis://127.0.0.1:6379/0
# ECOMMERCE_MYSQL_HOST=127.0.0.1
# ECOMMERCE_MYSQL_PORT=3306
# ECOMMERCE_MYSQL_USER=ecommerce
# ECOMMERCE_MYSQL_PASSWORD=replace-with-a-local-development-password
# ECOMMERCE_MYSQL_DATABASE=ecommerce
# ECOMMERCE_ADMIN_TOKEN=replace-with-a-random-local-admin-token
# ECOMMERCE_PAYMENT_CALLBACK_SECRET=replace-with-a-random-local-callback-secret
# ECOMMERCE_KAFKA_BROKERS=127.0.0.1:9092
# ECOMMERCE_ROCKETMQ_ENDPOINT=127.0.0.1:8081
